def setup_best_gpu():
    print("--- Searching for available GPU ---")
    try:
        # 查询所有 GPU 的剩余显存 (MB)
        cmd = ['nvidia-smi', '--query-gpu=memory.free', '--format=csv,nounits,noheader']
        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        
        if result.returncode != 0:
            print("⚠️ nvidia-smi failed. Defaulting to GPU 0")
            os.environ["CUDA_VISIBLE_DEVICES"] = "0"
            return

        # 解析输出
        free_memory = [int(x) for x in result.stdout.strip().split('\n')]
        best_gpu_index = int(np.argmax(free_memory))
        max_free = free_memory[best_gpu_index]
        
        print(f"   Found GPUs (Free Memory): {free_memory}")
        print(f"✅ Auto-selected Physical GPU: {best_gpu_index} (Free: {max_free} MB)")
        
        os.environ["CUDA_VISIBLE_DEVICES"] = str(best_gpu_index)
        
    except Exception as e:
        print(f"⚠️ GPU Selection failed: {e}. Defaulting to GPU 0")
        os.environ["CUDA_VISIBLE_DEVICES"] = "0"

# --- 执行选卡 ---
setup_best_gpu()

